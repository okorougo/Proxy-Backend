// Prisma schema file
// Define your data models here

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  RIDER
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String?
  phone              String?            @unique
  name               String?
  role               String             @default("USER")
  createdAt          DateTime           @default(now())
  isEmailVerified    Boolean            @default(false)
  listings           Listing[]
  media              Media[]
  reportsMade        Report[]           @relation("Reporter")
  reportsReviewed    Report[]           @relation("ReviewedBy")
  buyerTransactions  Transaction[]      @relation("buyerTransactions")
  sellerTransactions Transaction[]      @relation("sellerTransactions")
  auditLogs          AuditLog[]         @relation("Actor")
  messagesSent       Message[]          @relation("sentMessages")
  messagesRecv       Message[]          @relation("recvMessages")
  isKycVerified      Boolean            @default(false)
  kycDocument        KycVerification?
  kycDocumentId      String?
  givenReviews       Review[]           @relation("givenReviews")
  receivedReviews    Review[]           @relation("receivedReviews")
  Session            Session[]
  isBanned           Boolean            @default(false)
  otpCode            String? // temporary OTP code
  otpExpiresAt       DateTime?
  vendorApplication  VendorApplication?
  order              Order[]
  riderId            String?
  rider              Rider?

  // Social auth
  provider   String? // "google" | "apple"
  providerId String? // Google UID, Apple sub, etc
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  imageUrl    String?
  iconLib     String?
  iconName    String?
  listings    Listing[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model VendorApplication {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  description   String?
  status        VendorStatus @default(PENDING)
  rejectionNote String?
  location      Location?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order[]
}

model KycVerification {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  nin           String?
  selfieUrl     String?
  idCardUrl     String?
  status        KycStatus @default(PENDING)
  rejectionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model Listing {
  id           String        @id @default(uuid())
  title        String
  description  String
  priceCents   Int
  price        Float
  currency     String        @default("NGN")
  isDigital    Boolean       @default(false)
  condition    String? // e.g. "new", "used", "refurbished"
  stock        Int? // only for physical products
  seller       User          @relation(fields: [sellerId], references: [id])
  sellerId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  media        Media[]
  digitalFiles DigitalFile[] // 🔥 new relation
  transactions Transaction[]
  Message      Message[]
  status       ListingStatus @default(PENDING)
  categoryId   String
  extraDetails Json?
  category     Category      @relation(fields: [categoryId], references: [id])
  OrderItem    OrderItem[]
}

model DigitalFile {
  id        String   @id @default(uuid())
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  fileUrl   String // secure Cloudinary or storage URL
  publicId  String // Cloudinary public_id for future deletion
  filename  String?
  size      Int?
  url       String
  mimeType  String?
  createdAt DateTime @default(now())
}

model Location {
  id        String            @id @default(uuid())
  lat       Float
  lng       Float
  city      String?
  region    String?
  country   String?
  geohash   String            @db.VarChar(128)
  createdAt DateTime          @default(now())
  Address   String
  vendorId  String            @unique
  vendor    VendorApplication @relation(fields: [vendorId], references: [id])
}

model Media {
  id        String   @id @default(uuid())
  url       String
  publicId  String
  mimeType  String
  size      Int?
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  listing   Listing? @relation(fields: [listingId], references: [id])
  listingId String?
  createdAt DateTime @default(now())
}

model Order {
  id          String            @id @default(uuid())
  userId      String
  vendorId    String
  totalAmount Float
  status      String            @default("PENDING")
  createdAt   DateTime          @default(now())
  listings    OrderItem[]
  isDigital   Boolean           @default(false)
  delivery    Delivery?
  transaction Transaction?
  user        User              @relation(fields: [userId], references: [id])
  vendor      VendorApplication @relation(fields: [vendorId], references: [id])
}

model OrderItem {
  id            String       @id @default(uuid())
  orderId       String
  listingId     String
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  transactionId String?
  quantity      Int
  listing       Listing      @relation(fields: [listingId], references: [id])
  order         Order        @relation(fields: [orderId], references: [id])
  unitPrice     Float
}

model Message {
  id          String        @id @default(uuid())
  content     String?
  sender      User          @relation("sentMessages", fields: [senderId], references: [id])
  senderId    String
  recipient   User          @relation("recvMessages", fields: [recipientId], references: [id])
  listing     Listing?      @relation(fields: [listingId], references: [id])
  listingId   String?
  recipientId String
  mediaUrl    String? // For image or PDF
  messageType String        @default("TEXT") // TEXT | IMAGE | PDF
  text        String?
  status      MessageStatus @default(SENT)
  deliveredAt DateTime?
  readAt      DateTime?
  read        Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Report {
  id           String       @id @default(uuid())
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id])
  reporterId   String
  targetType   String // "listing" | "user" | "message"
  targetId     String
  reason       String
  status       ReportStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime     @default(now())
  reviewedBy   User?        @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  resolved     Boolean      @default(false)
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  REJECTED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     User     @relation("Actor", fields: [actorId], references: [id])
  actorId   String
  action    String // e.g. "REPORT_RESOLVED", "USER_SUSPENDED"
  meta      Json?
  createdAt DateTime @default(now())
}

model Transaction {
  id          String        @id @default(uuid())
  listingId   String? // keep for single-listing cases
  listing     Listing?      @relation(fields: [listingId], references: [id])
  orderId     String        @unique
  buyer       User          @relation("buyerTransactions", fields: [buyerId], references: [id])
  buyerId     String
  seller      User          @relation("sellerTransactions", fields: [sellerId], references: [id])
  sellerId    String
  amountCents Int
  currency    String        @default("NGN")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  receiptUrl  String? // Optional proof (image uploaded to Cloudinary)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  review      Review[]
  Delivery    Delivery[]
  order       Order         @relation(fields: [orderId], references: [id])
  orderItems  OrderItem[]
  amountPaid  Float?
  paystackRef String?
}

model Session {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  device         String?
  ip             String?
  deviceToken    String? // <-- store FCM / Expo push token here
  devicePlatform String? // e.g. "android","ios","expo"
  createdAt      DateTime @default(now())
  lastSeen       DateTime @default(now())
  revoked        Boolean  @default(false)
  socketId       String? // active socket connection
  isOnline       Boolean  @default(false)
}

model Review {
  id            String      @id @default(uuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String

  reviewer   User   @relation("givenReviews", fields: [reviewerId], references: [id])
  reviewerId String

  reviewee   User   @relation("receivedReviews", fields: [revieweeId], references: [id])
  revieweeId String

  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum PaymentMethod {
  CASH
  TRANSFER
  PAYSTACK
  FLUTTERWAVE
  STRIPE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Delivery {
  id            String      @id @default(uuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String

  rider   Rider?  @relation(fields: [riderId], references: [id])
  riderId String?
  orderId String  @unique

  pickupLat      Float
  pickupLng      Float
  dropoffLat     Float
  dropoffLng     Float
  pickupAddress  String
  dropoffAddress String

  status       DeliveryStatus @default(PENDING)
  distanceKm   Float?
  etaMinutes   Int?
  fareAmount   Float?
  isDigital    Boolean        @default(false)
  digitalFiles Json? // JSON array of signed download URLs

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  order       Order     @relation(fields: [orderId], references: [id])
}

model Rider {
  id          String        @id @default(uuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id])
  phone       String
  address     String?
  vehicleType String
  status        RiderStatus @default(PENDING)// PENDING, APPROVED, REJECTED
  isOnline    Boolean       @default(false)
  currentLat  Float?
  currentLng  Float?
  lastSeenAt  DateTime      @default(now())
  kyc         RiderKyc?
  vehicle     RiderVehicle?
  deliveries  Delivery[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model RiderKyc {
  id                String   @id @default(uuid())
  riderId           String   @unique
  rider             Rider    @relation(fields: [riderId], references: [id])
  ninNumber         String
  selfieUrl         String
  idCardUrl         String?
  idType            String   @default("NIN")
  licenseUrl        String?
  roadWorthinessUrl String?
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt         DateTime @default(now())
}

model RiderVehicle {
  id           String   @id @default(uuid())
  riderId      String   @unique
  rider        Rider    @relation(fields: [riderId], references: [id])
  brand        String
  model        String
  plateNumber  String?
  frontViewUrl String?
  backViewUrl  String?
  documentUrl  String? // registration doc or insurance
  createdAt    DateTime @default(now())
}

enum DeliveryStatus {
  PENDING // waiting for a rider
  ACCEPTED // rider accepted
  PICKED_UP // item picked
  IN_TRANSIT // en route
  DELIVERED // delivered successfully
  CANCELLED
}
enum RiderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}
